.venv/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.DS_Store

# EA .set presets may contain the Telegram bot token. Never commit a
# live preset from the MT5 data folder. The committed template
# mql5/Presets/GoldAIBridge.set must stay token-free.
*.set
!mql5/Presets/GoldAIBridge.set

# Large vendor caches and derived feature frames (rebuild with the download/dataset scripts)
data/raw/histdata/zips/
data/raw/histdata/cache/
data/processed/*.pkl
__pycache__/

# Walk-forward 1h equity curves are ~4MB each; summaries and trade lists are kept
research/deep-study-2026-11-14/results/trades/equity_*.csv

# Living decision file is written by the assistant and polled by the EA
decisions/current.json
